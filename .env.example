# Copie para .env (bash: cp .env.example .env · PowerShell: Copy-Item .env.example .env).
# Nunca commite o .env.

NODE_ENV=development
PORT=3000

# Banco local do compose.yaml (serviço db). Credenciais só para o container descartável local.
DATABASE_URL=postgresql://app:app_local_only@127.0.0.1:5432/api_cadastro?schema=public

# Obrigatório, mínimo de 32 bytes. Gere localmente:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ISSUER=api-cadastro
JWT_AUDIENCE=api-cadastro-client
REFRESH_TOKEN_TTL_DAYS=30

# Testes de integração usam o serviço db-test do compose.yaml (127.0.0.1:5433) por padrão.
# Defina TEST_DATABASE_URL só para apontar para outro banco de teste (ex.: no CI).
# TEST_DATABASE_URL=
